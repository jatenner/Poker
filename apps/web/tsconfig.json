{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "plugins": [
      { "name": "next" }
    ],
    "paths": {
      "@poker/shared": ["../../packages/shared/src"],
      "@poker/shared/*": ["../../packages/shared/src/*"],
      "@poker/db": ["../../packages/db/src"],
      "@poker/db/*": ["../../packages/db/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "next-env.d.ts", "app"],
  "exclude": ["node_modules"]
}
