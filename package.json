{
  "name": "poker",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @poker/web dev",
    "dev:server": "pnpm --filter @poker/server dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @poker/db migrate"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.6.2",
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
